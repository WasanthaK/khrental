NODE_ENV=development
PORT=5174
HOST=0.0.0.0

MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=khrental
MSSQL_AUTHENTICATION=sql-password
MSSQL_USER=sa
MSSQL_PASSWORD=change-me
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

AUTH_SESSION_TTL_DAYS=30
CORS_ORIGINS=

# Use local for development or r2 for stateless cloud hosting.
STORAGE_DRIVER=local
STORAGE_BUCKETS=images,files,documents,invoices,media,maintenance
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

VITE_API_ENDPOINT=
VITE_USE_MSSQL_API=true
VITE_ENABLE_DEV_BYPASS=false
VITE_APP_BASE_URL=http://localhost:5174
VITE_EMAIL_FROM=
VITE_EMAIL_FROM_NAME=KH Rentals

TWILIO_SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=KH Rentals
EVIA_SIGN_CLIENT_ID=
EVIA_SIGN_CLIENT_SECRET=
EVIA_SIGN_API_KEY=

# Optional platform recovery identity; disabled when empty. Requires verified mailbox proof.
PLATFORM_BOOTSTRAP_OWNER_EMAIL=

# Production credential quotas require a shared server-only HMAC key (32+ bytes).
# AUTH_THROTTLE_SECRET may reuse PUBLIC_SIGNUP_THROTTLE_SECRET when already set.
AUTH_THROTTLE_SECRET=
PUBLIC_SIGNUP_THROTTLE_SECRET=
# Configure only after proving the managed ingress contract; otherwise socket IP is used.
PUBLIC_SIGNUP_INGRESS_MODE=
PUBLIC_SIGNUP_TRUSTED_INGRESS_PEERS=
