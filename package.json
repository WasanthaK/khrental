{
  "name": "khrentals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup-env": "node scripts/setup-env.js",
    "generate-env-config": "node scripts/generate-env-config.js",
    "dev": "npm run generate-env-config && node server.js",
    "dev:vite": "npm run generate-env-config && vite",
    "build": "npm run generate-env-config && vite build",
    "test:authorization": "node --test tests/platform-authorization.test.js tests/permission-engine.test.js tests/membership-access-model.test.js tests/access-policy.test.js tests/route-policy.test.js tests/auth-redirect.test.js tests/invitation-security.test.js tests/password-reset-security.test.js tests/tenancy-activation.test.js tests/billing-lifecycle.test.js tests/maintenance-lifecycle.test.js tests/storage-delivery.test.js tests/tenancy-exit.test.js tests/agreement-document-merge.test.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "migrate": "node src/db/runMigration.js",
    "migrate:fresh:mssql": "node src/db/executeSql.js ./migrations/20260913_00_create_fresh_mssql_schema.sql",
    "migrate:staff-property-assignments": "node src/db/executeSql.js ./migrations/20260915_01_create_staff_property_assignments.sql",
    "migrate:user-invitations": "node src/db/executeSql.js ./migrations/20260915_02_create_user_invitations.sql",
    "migrate:password-reset-tokens": "node src/db/executeSql.js ./migrations/20260916_01_create_password_reset_tokens.sql",
    "migrate:staff-permission-bundles": "node src/db/executeSql.js ./migrations/20260916_02_add_staff_permission_bundles.sql",
    "migrate:tenancy-onboarding": "node src/db/executeSql.js ./migrations/20260916_03_add_tenancy_onboarding.sql",
    "migrate:billing-payment-lifecycle": "node src/db/executeSql.js ./migrations/20260916_04_add_billing_payment_lifecycle.sql",
    "migrate:maintenance-lifecycle": "node src/db/executeSql.js ./migrations/20260916_05_add_maintenance_lifecycle.sql",
    "migrate:tenancy-exit-settlement": "node src/db/executeSql.js ./migrations/20260916_06_add_tenancy_exit_settlement.sql",
    "migrate:billing-adjustments": "node src/db/executeSql.js ./migrations/20260920_01_add_tenancy_billing_adjustments.sql",
    "migrate:platform-admins": "node src/db/executeSql.js ./migrations/20260920_02_create_platform_admins.sql",
    "migrate:tenant:foundation": "node src/db/executeSql.js ./migrations/20260317_01_create_multi_tenant_foundation.sql",
    "migrate:tenant:backfill": "node src/db/executeSql.js ./migrations/20260317_02_backfill_default_tenant.sql",
    "add-properties-column": "node src/scripts/add_associated_properties_column.js",
    "execute-sql": "node src/db/executeSql.js",
    "find-deprecated": "node scripts/find_deprecated_tables.js",
    "fix-property-timestamps": "node src/scripts/fixAppUsersPropertyIds.js",
    "standardize-timestamps": "node src/scripts/standardizeTimestampColumns.js",
    "run-fixes": "node src/db/executeSql.js ../scripts/manual_fixes.sql",
    "bucket-test": "node src/scripts/bucketTest.js",
    "list-buckets": "node -e \"import('./src/services/bucketExplorer.js').then(({default: explorer}) => explorer.listAllBuckets().then(({buckets}) => console.log(buckets)))\"",
    "setup-storage": "node src/scripts/setup_storage.js",
    "setup-storage-policies": "node src/scripts/setup_storage_policies.js",
    "validate:tenant-storage": "node scripts/validate-tenant-storage.mjs",
    "migrate:tenant-storage-assets": "node scripts/migrate-legacy-storage-assets.mjs",
    "create-exec-sql": "node src/scripts/create_exec_sql_function.js",
    "setup-signature": "node src/scripts/setupAgreementSignature.js",
    "test-webhook": "node --experimental-modules scripts/test-local-webhook.js",
    "verify-azure": "node scripts/verify-azure-configuration.js",
    "proxy": "node cors-proxy.js",
    "dev:with-proxy": "concurrently \"npm run proxy\" \"npm run dev\"",
    "start": "node start-dev.js",
    "test:mobile": "node mobile-test.js",
    "test:mobile:chrome": "node testing/mobile/chrome-test.js",
    "migrate:auth:legacy": "node scripts/migrate-local-auth-to-mssql.mjs"
  },
